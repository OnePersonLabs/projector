{
  "name": "projector",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "create-migration": "node scripts/create-project-data-migration.mjs",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "acceptance:knowledge": "node scripts/knowledge-acceptance.mjs",
    "plugin:proposal-schema": "node scripts/generate-plugin-proposal-schema.mjs",
    "plugin:proposal-schema:check": "node scripts/generate-plugin-proposal-schema.mjs --check",
    "spec:check": "python3 PROJECTOR_SPEC/scripts/check_spec.py && node scripts/check-spec-human-technical.mjs",
    "spec:check:engine-style": "node scripts/check-spec-human-technical.mjs",
    "release:acceptance": "node scripts/run-release-acceptance.mjs",
    "release:artifacts": "node scripts/generate-release-artifacts.mjs",
    "release:artifacts:check": "node scripts/generate-release-artifacts.mjs --check",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm typecheck && pnpm test && pnpm check:boundaries && pnpm spec:check"
  },
  "devDependencies": {
    "@projector/analyzers": "workspace:*",
    "@projector/core": "workspace:*",
    "@projector/testkit": "workspace:*",
    "@types/node": "^24.2.1",
    "fast-check": "^4.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
