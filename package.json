{
  "name": "projector",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "release:acceptance": "pnpm sandbox:ensure && node scripts/run-release-acceptance.mjs",
    "release:artifacts": "node scripts/generate-release-artifacts.mjs",
    "release:artifacts:check": "node scripts/generate-release-artifacts.mjs --check",
    "sandbox:ensure": "node scripts/ensure-dev-sandbox.mjs",
    "test": "pnpm sandbox:ensure && vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm typecheck && pnpm test && pnpm check:boundaries"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "fast-check": "^4.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
