{
  "name": "projector",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "plugin:proposal-schema": "node scripts/generate-plugin-proposal-schema.mjs",
    "plugin:proposal-schema:check": "node scripts/generate-plugin-proposal-schema.mjs --check",
    "plugin:prepare-local": "pnpm build && node scripts/prepare-local-marketplace.mjs",
    "spec:check": "node scripts/check-spec-human-technical.mjs",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm typecheck && pnpm test && pnpm check:boundaries && pnpm spec:check",
    "release:check": "node scripts/check-installed-workflow.mjs"
  },
  "devDependencies": {
    "@projector/analyzers": "workspace:*",
    "@projector/control-plane": "workspace:*",
    "@projector/core": "workspace:*",
    "@projector/engine": "workspace:*",
    "@projector/runtime": "workspace:*",
    "@projector/testkit": "workspace:*",
    "@types/node": "^24.2.1",
    "fast-check": "^4.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
