{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/projector-context.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/projector-context.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 8192
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/projector-context.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/projector-context.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 8192
          }
        ]
      }
    ]
  }
}
