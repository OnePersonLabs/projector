{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/projector-instructions.mjs\"",
            "statusMessage": "Loading Projector",
            "additionalContextLimit": 4096,
            "timeout": 12
          }
        ]
      }
    ]
  }
}
