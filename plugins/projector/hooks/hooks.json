{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/projector-session.sh\"",
            "statusMessage": "Loading Projector context",
            "additionalContextLimit": 256
          }
        ]
      }
    ]
  }
}
