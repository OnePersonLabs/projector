{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/projector-session.mjs\"",
            "statusMessage": "Loading Projector context",
            "additionalContextLimit": 256
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/projector-session.mjs\"",
            "statusMessage": "Checking Projector readiness",
            "additionalContextLimit": 256
          }
        ]
      }
    ]
  }
}
